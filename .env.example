# Root-level Docker Compose configuration for staging/production.
# Copy to .env and replace every CHANGE_ME value before starting services.
# Keep this file untracked; never commit .env or production secrets.

# Must match the POSTGRES_PASSWORD below. URL-encode special characters in the password.
DATABASE_URL=postgresql://eduflow:CHANGE_ME_URL_ENCODED@postgres:5432/eduflow?schema=public
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
DEFAULT_USER_PASSWORD=CHANGE_ME_INITIAL_USER_PASSWORD
ROOT_EMAIL=CHANGE_ME_ADMIN_EMAIL
ROOT_USERNAME=root
ROOT_NAME=Root Administrator
ROOT_PASSWORD=CHANGE_ME_UNIQUE_ROOT_PASSWORD
FRONTEND_URL=https://your-eduflow-domain.example
FRONTEND_ALLOWED_ORIGINS=https://your-eduflow-domain.example
NEXT_PUBLIC_API_URL=/api/backend
BACKEND_INTERNAL_API_URL=http://backend:3001/api
REDIS_HOST=redis
REDIS_PORT=6379
SCHOOL_TIMEZONE_OFFSET_MINUTES=420
