generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SignatureMode {
  MANUAL
  TTE
}

enum OutgoingLetterStatus {
  DRAFT
  PENDING_APPROVAL
  REVISION_REQUESTED
  APPROVED
}

enum SemesterType {
  ODD
  EVEN
}

enum AcademicCalendarEventType {
  HOLIDAY
  EXAM
  SCHOOL_ACTIVITY
  NATIONAL_CEREMONY
  NON_TEACHING_DAY
  OTHER
}

enum TeacherAssignmentStatus {
  ACTIVE
  RETIRED
  TRANSFERRED
  ON_LEAVE
  INACTIVE
}

enum AcademicTimeSlotType {
  LESSON
  BREAK
  CEREMONY
  EXERCISE
  CO_CURRICULAR
  RELIGIOUS
  OTHER
}

enum ClassTimeSlotActivityType {
  BREAK
  RELIGIOUS
}

enum TeachingPlanType {
  ANNUAL_PROGRAM
  SEMESTER_PROGRAM
  KKTP
  LESSON_PLAN
  TEACHING_BOOK
}

enum TeachingPlanStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  ARCHIVED
}

enum TeachingPlanRevisionPriority {
  HIGH
  MEDIUM
  LOW
}

enum AssessmentType {
  DAILY_TASK
  QUIZ
  DAILY_TEST
  PRACTICE
  PROJECT
  PORTFOLIO
  OBSERVATION
  OTHER
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  LOCKED
  REVISION_REQUESTED
}

enum TeachingJournalStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum AgendaStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EMPTY
}

enum AttendanceStatus {
  PRESENT
  SICK
  EXCUSED
  ABSENT
}

enum AttendanceState {
  DRAFT
  SUBMITTED
  APPROVED
  CORRECTION_REQUESTED
  CORRECTED
  LOCKED
  VOID
}

enum ExtracurricularParticipationPolicy {
  OPTIONAL
  MANDATORY_GRADE
}

enum ExtracurricularEnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

enum ExtracurricularEnrollmentType {
  MANDATORY
  VOLUNTARY
}

enum ExtracurricularSessionStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum ExtracurricularAttendanceStatus {
  PRESENT
  SICK
  EXCUSED
  ABSENT
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum StudentLeaveRequestType {
  SICK
  EXCUSED
}

enum StudentLeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
}

enum NotificationChannel {
  WHATSAPP
  TELEGRAM
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum FeeFrequency {
  ONCE
  MONTHLY
  SEMESTER
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethodType {
  CASH
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  EWALLET
  QRIS
  OTHER
}

enum LoginAuditStatus {
  SUCCESS
  FAILED
  LOCKED
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  username              String?               @unique
  password              String
  name                  String
  email                 String                @unique
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime? @db.Timestamptz(3)
  failedLoginCount      Int                   @default(0)
  lockedUntil           DateTime? @db.Timestamptz(3)
  lastLoginAt           DateTime? @db.Timestamptz(3)
  passwordChangedAt     DateTime? @db.Timestamptz(3)
  photoKey              String?
  photoName             String?
  photoMimeType         String?
  photoSize             Int?
  telegramId            String?               @unique
  telegramLinkedAt      DateTime? @db.Timestamptz(3)
  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  telegramLinkTokens    TelegramLinkToken[]
  loginAudits           LoginAudit[]
  submittedAttendances  Attendance[]          @relation("AttendanceSubmittedBy")
  approvedAttendances   Attendance[]          @relation("AttendanceApprovedBy")
  correctedAttendances  Attendance[]          @relation("AttendanceCorrectedBy")
  lockedAttendances     Attendance[]          @relation("AttendanceLockedBy")
  receivedPayments      Payment[]             @relation("PaymentReceivedBy")
  teacherProfile        Teacher?
  reviewedTeachingPlans TeachingPlan[]        @relation("TeachingPlanReviewedBy")
  submittedAssessments  Assessment[]          @relation("AssessmentSubmittedBy")
  requestedLeaves       StudentLeaveRequest[] @relation("StudentLeaveRequestedBy")
  reviewedLeaves        StudentLeaveRequest[] @relation("StudentLeaveReviewedBy")
  notifications         NotificationLog[]
  createdOutgoingLetters OutgoingLetter[] @relation("OutgoingLetterCreator")
  approvedOutgoingLetters OutgoingLetter[] @relation("OutgoingLetterApprover")
  receivedIncomingLetters IncomingLetter[] @relation("IncomingLetterReceiver")

  @@index([lockedUntil])
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime @db.Timestamptz(3)
  ipAddress     String?
  userAgent     String?
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model TelegramLinkToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model LoginAudit {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String?          @db.Uuid
  email     String
  status    LoginAuditStatus
  ipAddress String?
  userAgent String?
  reason    String?
  user      User?            @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model SchoolYear {
  id                 String                        @id @default(uuid()) @db.Uuid
  name               String                        @unique
  startsAt                    DateTime @db.Timestamptz(3)
  endsAt                      DateTime @db.Timestamptz(3)
  morningAssemblyEnabled      Boolean   @default(false)
  morningAssemblyStartsAt     String    @default("06:50")
  morningAssemblyEndsAt       String    @default("07:10")
  semesters                   Semester[]
  classes            Class[]
  enrollments        StudentEnrollment[]
  schedules          Schedule[]
  agendas            DailyAgenda[]
  timeSlots          AcademicTimeSlot[]
  feeTypes           FeeType[]
  invoices           Invoice[]
  teachingPlans      TeachingPlan[]
  assessments        Assessment[]
  calendarEvents     AcademicCalendarEvent[]
  teacherAssignments TeacherSchoolYearAssignment[]
  extracurriculars Extracurricular[]
  createdAt          DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                      @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)
}

model AcademicTimeSlot {
  id                String                  @id @default(uuid()) @db.Uuid
  schoolYearId      String                  @db.Uuid
  dayOfWeek         Int
  periodNumber      Int?
  name              String
  type              AcademicTimeSlotType
  startsAt          String
  endsAt            String
  isAssignable      Boolean                 @default(true)
  isActive          Boolean                 @default(true)
  schoolYear        SchoolYear              @relation(fields: [schoolYearId], references: [id])
  schedules         Schedule[]
  scheduleRevisions ScheduleRevision[]
  classActivities   ClassTimeSlotActivity[]
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  @@index([schoolYearId, dayOfWeek, periodNumber])
  @@index([isActive])
}

model ClassTimeSlotActivity {
  id         String                    @id @default(uuid()) @db.Uuid
  classId    String                    @db.Uuid
  timeSlotId String                    @db.Uuid
  type       ClassTimeSlotActivityType @default(BREAK)
  class      Class                     @relation(fields: [classId], references: [id])
  timeSlot   AcademicTimeSlot          @relation(fields: [timeSlotId], references: [id])
  createdAt  DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                  @updatedAt @db.Timestamptz(3)

  @@unique([classId, timeSlotId])
  @@index([classId])
  @@index([timeSlotId])
}

model Semester {
  id                String                  @id @default(uuid()) @db.Uuid
  schoolYearId      String                  @db.Uuid
  type              SemesterType
  startsAt          DateTime @db.Timestamptz(3)
  endsAt            DateTime @db.Timestamptz(3)
  schoolYear        SchoolYear              @relation(fields: [schoolYearId], references: [id])
  schedules         Schedule[]
  scheduleRevisions ScheduleRevision[]
  agendas           DailyAgenda[]
  teachingPlans     TeachingPlan[]
  assessments       Assessment[]
  calendarEvents    AcademicCalendarEvent[]
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  @@unique([schoolYearId, type])
  @@index([schoolYearId])
}

model Class {
  id                 String                  @id @default(uuid()) @db.Uuid
  schoolYearId       String                  @db.Uuid
  homeroomTeacherId  String?                 @db.Uuid
  name               String
  code               String?
  grade              String?
  schoolYear         SchoolYear              @relation(fields: [schoolYearId], references: [id])
  homeroomTeacher    Teacher?                @relation("ClassHomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  enrollments        StudentEnrollment[]
  schedules          Schedule[]
  scheduleRevisions  ScheduleRevision[]
  agendas            DailyAgenda[]
  attendances        Attendance[]
  classJournalNotes  ClassJournalNote[]
  assessments        Assessment[]
  timeSlotActivities ClassTimeSlotActivity[]
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  @@unique([schoolYearId, name])
  @@unique([schoolYearId, code])
  @@index([schoolYearId])
  @@index([homeroomTeacherId])
}

model AcademicCalendarEvent {
  id           String                    @id @default(uuid()) @db.Uuid
  schoolYearId String                    @db.Uuid
  semesterId   String?                   @db.Uuid
  title        String
  description  String?
  type         AcademicCalendarEventType
  startsAt     DateTime                  @db.Date
  endsAt       DateTime                  @db.Date
  blocksAgenda Boolean                   @default(true)
  scheduleShiftFromDay Int?
  scheduleShiftToDay   Int?
  schoolYear   SchoolYear                @relation(fields: [schoolYearId], references: [id])
  semester     Semester?                 @relation(fields: [semesterId], references: [id])
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  @@index([schoolYearId, startsAt, endsAt])
  @@index([semesterId])
  @@index([blocksAgenda])
}

model Subject {
  id                String                     @id @default(uuid()) @db.Uuid
  name              String
  code              String?
  isActive          Boolean                    @default(true)
  schedules         Schedule[]
  scheduleRevisions ScheduleRevision[]
  agendas           DailyAgenda[]
  teachers          TeacherSubject[]
  yearAssignments   TeacherSchoolYearSubject[]
  teachingPlans     TeachingPlan[]
  assessments       Assessment[]
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)
}

model Teacher {
  id                String                        @id @default(uuid()) @db.Uuid
  userId            String?                       @unique @db.Uuid
  name              String
  nip               String?                       @unique
  nuptk             String?                       @unique
  email             String?                       @unique
  phone             String?
  telegramId        String?
  photoUrl          String?
  photoKey          String?
  photoName         String?
  photoMimeType     String?
  photoSize         Int?
  isActive          Boolean                       @default(true)
  schedules         Schedule[]
  scheduleRevisions ScheduleRevision[]
  agendas           DailyAgenda[]
  substituteAgendas DailyAgenda[]                 @relation("DailyAgendaSubstituteTeacher")
  assessments       Assessment[]
  user              User?                         @relation(fields: [userId], references: [id])
  subjects          TeacherSubject[]
  homeroomClasses   Class[]                       @relation("ClassHomeroomTeacher")
  teachingPlans     TeachingPlan[]
  teachingJournals  TeachingJournal[]
  classJournalNotes ClassJournalNote[]
  yearAssignments   TeacherSchoolYearAssignment[]
  extracurricularAdvisories ExtracurricularAdvisor[]
  createdAt         DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                      @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  @@index([phone])
  @@index([telegramId])
  @@index([isActive])
  @@index([userId])
}

model TeacherSubject {
  teacherId String   @db.Uuid
  subjectId String   @db.Uuid
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model TeacherSchoolYearAssignment {
  id           String                     @id @default(uuid()) @db.Uuid
  teacherId    String                     @db.Uuid
  schoolYearId String                     @db.Uuid
  status       TeacherAssignmentStatus    @default(ACTIVE)
  notes        String?
  teacher      Teacher                    @relation(fields: [teacherId], references: [id])
  schoolYear   SchoolYear                 @relation(fields: [schoolYearId], references: [id])
  subjects     TeacherSchoolYearSubject[]
  createdAt    DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                   @updatedAt @db.Timestamptz(3)

  @@unique([teacherId, schoolYearId])
  @@index([schoolYearId, status])
}

model TeacherSchoolYearSubject {
  assignmentId String                      @db.Uuid
  subjectId    String                      @db.Uuid
  assignment   TeacherSchoolYearAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  subject      Subject                     @relation(fields: [subjectId], references: [id])
  createdAt    DateTime                    @default(now()) @db.Timestamptz(3)

  @@id([assignmentId, subjectId])
  @@index([subjectId])
}

model TeachingPlan {
  id                   String                        @id @default(uuid()) @db.Uuid
  teacherId            String                        @db.Uuid
  subjectId            String                        @db.Uuid
  schoolYearId         String                        @db.Uuid
  semesterId           String?                       @db.Uuid
  type                 TeachingPlanType
  title                String
  description          String?
  attachmentUrl        String?
  attachmentKey        String?
  attachmentName       String?
  attachmentMimeType   String?
  attachmentSize       Int?
  attachmentUploadedAt DateTime? @db.Timestamptz(3)
  status               TeachingPlanStatus            @default(DRAFT)
  submittedAt          DateTime? @db.Timestamptz(3)
  reviewedAt           DateTime? @db.Timestamptz(3)
  reviewedById         String?                       @db.Uuid
  reviewNote           String?
  reviewSection        String?
  reviewPriority       TeachingPlanRevisionPriority?
  teacher              Teacher                       @relation(fields: [teacherId], references: [id])
  subject              Subject                       @relation(fields: [subjectId], references: [id])
  schoolYear           SchoolYear                    @relation(fields: [schoolYearId], references: [id])
  semester             Semester?                     @relation(fields: [semesterId], references: [id])
  reviewedBy           User?                         @relation("TeachingPlanReviewedBy", fields: [reviewedById], references: [id])
  createdAt            DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                      @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime? @db.Timestamptz(3)

  @@index([teacherId, schoolYearId, semesterId])
  @@index([status, type])
  @@index([reviewedById])
}

model Assessment {
  id             String            @id @default(uuid()) @db.Uuid
  teacherId      String            @db.Uuid
  schoolYearId   String            @db.Uuid
  semesterId     String            @db.Uuid
  classId        String            @db.Uuid
  subjectId      String            @db.Uuid
  title          String
  type           AssessmentType
  assessmentDate DateTime          @db.Date
  maxScore       Decimal           @default(100) @db.Decimal(5, 2)
  weight         Decimal           @default(1) @db.Decimal(5, 2)
  status         AssessmentStatus  @default(DRAFT)
  submittedAt    DateTime? @db.Timestamptz(3)
  submittedById  String?           @db.Uuid
  lockedAt       DateTime? @db.Timestamptz(3)
  notes          String?
  teacher        Teacher           @relation(fields: [teacherId], references: [id])
  schoolYear     SchoolYear        @relation(fields: [schoolYearId], references: [id])
  semester       Semester          @relation(fields: [semesterId], references: [id])
  class          Class             @relation(fields: [classId], references: [id])
  subject        Subject           @relation(fields: [subjectId], references: [id])
  submittedBy    User?             @relation("AssessmentSubmittedBy", fields: [submittedById], references: [id])
  scores         AssessmentScore[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  @@index([teacherId, schoolYearId, semesterId])
  @@index([classId, subjectId, assessmentDate])
  @@index([status])
}

model AssessmentScore {
  id           String            @id @default(uuid()) @db.Uuid
  assessmentId String            @db.Uuid
  studentId    String            @db.Uuid
  enrollmentId String            @db.Uuid
  score        Decimal?          @db.Decimal(5, 2)
  notes        String?
  assessment   Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id])
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id])
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([assessmentId, enrollmentId])
  @@index([studentId])
  @@index([enrollmentId])
}

model Extracurricular {
  id                  String                            @id @default(uuid()) @db.Uuid
  schoolYearId        String                            @db.Uuid
  name                String
  code                String?
  category            String                            @default("LAINNYA")
  description         String?
  participationPolicy ExtracurricularParticipationPolicy @default(OPTIONAL)
  mandatoryGrades     Int[]                             @default([])
  quota               Int?
  location            String?
  scheduleNotes       String?
  isActive            Boolean                           @default(true)
  schoolYear          SchoolYear                        @relation(fields: [schoolYearId], references: [id])
  advisors            ExtracurricularAdvisor[]
  enrollments         ExtracurricularEnrollment[]
  sessions            ExtracurricularSession[]
  createdAt           DateTime                          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                          @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime? @db.Timestamptz(3)

  @@unique([schoolYearId, name])
  @@index([schoolYearId, isActive])
}

model ExtracurricularAdvisor {
  extracurricularId String          @db.Uuid
  teacherId         String          @db.Uuid
  extracurricular   Extracurricular @relation(fields: [extracurricularId], references: [id], onDelete: Cascade)
  teacher           Teacher         @relation(fields: [teacherId], references: [id])
  assignedAt        DateTime        @default(now()) @db.Timestamptz(3)

  @@id([extracurricularId, teacherId])
  @@index([teacherId])
}

model ExtracurricularEnrollment {
  id                String                         @id @default(uuid()) @db.Uuid
  extracurricularId String                         @db.Uuid
  studentId         String                         @db.Uuid
  status            ExtracurricularEnrollmentStatus @default(ACTIVE)
  enrollmentType    ExtracurricularEnrollmentType  @default(VOLUNTARY)
  enrolledAt        DateTime                       @default(now()) @db.Timestamptz(3)
  notes             String?
  extracurricular   Extracurricular                @relation(fields: [extracurricularId], references: [id])
  student           Student                        @relation(fields: [studentId], references: [id])
  attendanceItems   ExtracurricularAttendance[]
  createdAt         DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                       @updatedAt @db.Timestamptz(3)

  @@unique([extracurricularId, studentId])
  @@index([studentId, status])
}

model ExtracurricularSession {
  id                String                       @id @default(uuid()) @db.Uuid
  extracurricularId String                       @db.Uuid
  startsAt          DateTime @db.Timestamptz(3)
  endsAt            DateTime? @db.Timestamptz(3)
  location          String?
  activityNotes     String?
  status            ExtracurricularSessionStatus @default(DRAFT)
  createdByUserId   String                       @db.Uuid
  submittedByUserId String?                      @db.Uuid
  submittedAt       DateTime? @db.Timestamptz(3)
  extracurricular   Extracurricular              @relation(fields: [extracurricularId], references: [id])
  attendanceItems   ExtracurricularAttendance[]
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)

  @@index([extracurricularId, startsAt])
  @@index([status])
}

model ExtracurricularAttendance {
  id             String                         @id @default(uuid()) @db.Uuid
  sessionId      String                         @db.Uuid
  studentId      String                         @db.Uuid
  enrollmentId   String                         @db.Uuid
  status         ExtracurricularAttendanceStatus @default(PRESENT)
  notes          String?
  markedByUserId String?                        @db.Uuid
  markedAt       DateTime                       @default(now()) @db.Timestamptz(3)
  session        ExtracurricularSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        Student                        @relation(fields: [studentId], references: [id])
  enrollment     ExtracurricularEnrollment      @relation(fields: [enrollmentId], references: [id])
  revisions      ExtracurricularAttendanceRevision[]

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

model ExtracurricularAttendanceRevision {
  id              String                         @id @default(uuid()) @db.Uuid
  attendanceId    String                         @db.Uuid
  oldStatus       ExtracurricularAttendanceStatus
  newStatus       ExtracurricularAttendanceStatus
  reason          String
  changedByUserId String                         @db.Uuid
  createdAt       DateTime                       @default(now()) @db.Timestamptz(3)
  attendance      ExtracurricularAttendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  @@index([attendanceId, createdAt])
  @@index([changedByUserId, createdAt])
}

model Student {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  nis              String?               @unique
  nisn             String?               @unique
  gender           Gender?
  birthDate        DateTime?             @db.Date
  phone            String?
  isActive         Boolean               @default(true)
  enrollments      StudentEnrollment[]
  guardians        StudentGuardian[]
  attendanceItems  AttendanceItem[]
  assessmentScores AssessmentScore[]
  invoices         Invoice[]
  payments         Payment[]
  leaveRequests    StudentLeaveRequest[]
  extracurricularEnrollments ExtracurricularEnrollment[]
  extracurricularAttendances ExtracurricularAttendance[]
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  @@index([phone])
  @@index([isActive])
}

model Guardian {
  id            String                @id @default(uuid()) @db.Uuid
  name          String
  phone         String?
  telegramId    String?
  email         String?
  address       String?
  isActive      Boolean               @default(true)
  students      StudentGuardian[]
  invoices      Invoice[]
  payments      Payment[]
  leaveRequests StudentLeaveRequest[]
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)

  @@index([phone])
  @@index([telegramId])
  @@index([email])
  @@index([isActive])
}

model StudentGuardian {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @db.Uuid
  guardianId String           @db.Uuid
  relation   GuardianRelation
  isPrimary  Boolean          @default(false)
  student    Student          @relation(fields: [studentId], references: [id])
  guardian   Guardian         @relation(fields: [guardianId], references: [id])
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  @@unique([studentId, guardianId])
  @@index([studentId, isPrimary])
  @@index([guardianId])
}

model StudentEnrollment {
  id               String            @id @default(uuid()) @db.Uuid
  studentId        String            @db.Uuid
  classId          String            @db.Uuid
  schoolYearId     String            @db.Uuid
  isActive         Boolean           @default(true)
  startedAt        DateTime          @default(now()) @db.Timestamptz(3)
  endedAt          DateTime? @db.Timestamptz(3)
  student          Student           @relation(fields: [studentId], references: [id])
  class            Class             @relation(fields: [classId], references: [id])
  schoolYear       SchoolYear        @relation(fields: [schoolYearId], references: [id])
  attendanceItems  AttendanceItem[]
  assessmentScores AssessmentScore[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  @@unique([studentId, classId, schoolYearId])
  @@index([studentId, schoolYearId])
  @@index([classId, isActive])
  @@index([schoolYearId, isActive])
}

model Schedule {
  id           String             @id @default(uuid()) @db.Uuid
  schoolYearId String             @db.Uuid
  semesterId   String             @db.Uuid
  classId      String             @db.Uuid
  subjectId    String             @db.Uuid
  teacherId    String             @db.Uuid
  timeSlotId   String?            @db.Uuid
  dayOfWeek    Int
  startsAt     String
  endsAt       String
  room         String?
  isActive     Boolean            @default(true)
  schoolYear   SchoolYear         @relation(fields: [schoolYearId], references: [id])
  semester     Semester           @relation(fields: [semesterId], references: [id])
  class        Class              @relation(fields: [classId], references: [id])
  subject      Subject            @relation(fields: [subjectId], references: [id])
  teacher      Teacher            @relation(fields: [teacherId], references: [id])
  timeSlot     AcademicTimeSlot?  @relation(fields: [timeSlotId], references: [id])
  revisions    ScheduleRevision[]
  agendas      DailyAgenda[]
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  @@index([schoolYearId, semesterId])
  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([timeSlotId])
  @@index([isActive])
}

model ScheduleRevision {
  id            String            @id @default(uuid()) @db.Uuid
  scheduleId    String            @db.Uuid
  semesterId    String            @db.Uuid
  effectiveFrom DateTime          @db.Date
  classId       String            @db.Uuid
  subjectId     String            @db.Uuid
  teacherId     String            @db.Uuid
  timeSlotId    String?           @db.Uuid
  dayOfWeek     Int
  startsAt      String
  endsAt        String
  room          String?
  reason        String?
  schedule      Schedule          @relation(fields: [scheduleId], references: [id])
  semester      Semester          @relation(fields: [semesterId], references: [id])
  class         Class             @relation(fields: [classId], references: [id])
  subject       Subject           @relation(fields: [subjectId], references: [id])
  teacher       Teacher           @relation(fields: [teacherId], references: [id])
  timeSlot      AcademicTimeSlot? @relation(fields: [timeSlotId], references: [id])
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([scheduleId, effectiveFrom])
  @@index([semesterId, effectiveFrom])
}

model DailyAgenda {
  id                  String       @id @default(uuid()) @db.Uuid
  scheduleId          String?      @db.Uuid
  schoolYearId        String       @db.Uuid
  semesterId          String       @db.Uuid
  classId             String       @db.Uuid
  subjectId           String       @db.Uuid
  teacherId           String       @db.Uuid
  substituteTeacherId String?      @db.Uuid
  date                DateTime     @db.Date
  effectivePeriodNumber Int?
  effectiveStartsAt   String?
  effectiveEndsAt     String?
  status              AgendaStatus @default(SCHEDULED)
  schedule            Schedule?    @relation(fields: [scheduleId], references: [id])
  schoolYear          SchoolYear   @relation(fields: [schoolYearId], references: [id])
  semester            Semester     @relation(fields: [semesterId], references: [id])
  class               Class        @relation(fields: [classId], references: [id])
  subject             Subject      @relation(fields: [subjectId], references: [id])
  teacher             Teacher      @relation(fields: [teacherId], references: [id])
  substituteTeacher   Teacher?     @relation("DailyAgendaSubstituteTeacher", fields: [substituteTeacherId], references: [id])
  attendance          Attendance?
  teachingJournal     TeachingJournal?
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([scheduleId, date])
  @@index([date, status])
  @@index([schoolYearId, semesterId])
  @@index([classId, date])
  @@index([teacherId, date])
  @@index([substituteTeacherId, date])
}

model TeachingJournal {
  id                 String                @id @default(uuid()) @db.Uuid
  agendaId           String                @unique @db.Uuid
  teacherId          String                @db.Uuid
  learningObjectives String?
  material           String
  learningActivities String?
  learningOutcome    String?
  reflection         String?
  issueNotes         String?
  status             TeachingJournalStatus @default(DRAFT)
  submittedAt        DateTime? @db.Timestamptz(3)
  lockedAt           DateTime? @db.Timestamptz(3)
  agenda             DailyAgenda           @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  teacher            Teacher               @relation(fields: [teacherId], references: [id])
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  @@index([teacherId, status])
}

model ClassJournalNote {
  id              String   @id @default(uuid()) @db.Uuid
  classId         String   @db.Uuid
  date            DateTime @db.Date
  authorTeacherId String   @db.Uuid
  content         String
  schoolClass     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorTeacher   Teacher  @relation(fields: [authorTeacherId], references: [id])
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([classId, date])
  @@index([authorTeacherId, createdAt])
}

model Attendance {
  id                    String           @id @default(uuid()) @db.Uuid
  agendaId              String           @unique @db.Uuid
  classId               String           @db.Uuid
  state                 AttendanceState  @default(DRAFT)
  startedAt             DateTime? @db.Timestamptz(3)
  submittedAt           DateTime? @db.Timestamptz(3)
  submittedById         String?          @db.Uuid
  approvedAt            DateTime? @db.Timestamptz(3)
  approvedById          String?          @db.Uuid
  correctionAt          DateTime? @db.Timestamptz(3)
  correctedById         String?          @db.Uuid
  lockedAt              DateTime? @db.Timestamptz(3)
  lockedById            String?          @db.Uuid
  endedAt               DateTime? @db.Timestamptz(3)
  notes                 String?
  teacherPresent        Boolean?
  studentAttendanceDone Boolean?
  materialFilled        Boolean?
  classPhotoDone        Boolean?
  issueNotes            String?
  classPhotoKey         String?
  classPhotoName        String?
  classPhotoMimeType    String?
  classPhotoSize        Int?
  classPhotoUploadedAt  DateTime? @db.Timestamptz(3)
  classPhotoTakenAt     DateTime? @db.Timestamptz(3)
  classPhotoLatitude    Float?
  classPhotoLongitude   Float?
  classPhotoAccuracy    Float?
  correctionNote        String?
  agenda                DailyAgenda      @relation(fields: [agendaId], references: [id])
  class                 Class            @relation(fields: [classId], references: [id])
  submittedBy           User?            @relation("AttendanceSubmittedBy", fields: [submittedById], references: [id])
  approvedBy            User?            @relation("AttendanceApprovedBy", fields: [approvedById], references: [id])
  correctedBy           User?            @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id])
  lockedBy              User?            @relation("AttendanceLockedBy", fields: [lockedById], references: [id])
  items                 AttendanceItem[]
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  @@index([classId])
  @@index([state])
  @@index([classId, state])
  @@index([submittedById])
  @@index([approvedById])
  @@index([correctedById])
  @@index([lockedById])
}

model AttendanceItem {
  id           String            @id @default(uuid()) @db.Uuid
  attendanceId String            @db.Uuid
  studentId    String            @db.Uuid
  enrollmentId String            @db.Uuid
  status       AttendanceStatus
  notes        String?
  attendance   Attendance        @relation(fields: [attendanceId], references: [id])
  student      Student           @relation(fields: [studentId], references: [id])
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id])
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([attendanceId, studentId])
  @@unique([attendanceId, enrollmentId])
  @@index([studentId])
  @@index([enrollmentId])
}

model StudentLeaveRequest {
  id                 String                    @id @default(uuid()) @db.Uuid
  studentId          String                    @db.Uuid
  guardianId         String                    @db.Uuid
  requestedById      String?                   @db.Uuid
  dateFrom           DateTime                  @db.Date
  dateTo             DateTime                  @db.Date
  type               StudentLeaveRequestType
  status             StudentLeaveRequestStatus @default(PENDING)
  reason             String
  attachmentKey      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  reviewedById       String?                   @db.Uuid
  reviewedAt         DateTime? @db.Timestamptz(3)
  reviewNote         String?
  cancelledAt        DateTime? @db.Timestamptz(3)
  student            Student                   @relation(fields: [studentId], references: [id])
  guardian           Guardian                  @relation(fields: [guardianId], references: [id])
  requestedBy        User?                     @relation("StudentLeaveRequestedBy", fields: [requestedById], references: [id])
  reviewedBy         User?                     @relation("StudentLeaveReviewedBy", fields: [reviewedById], references: [id])
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  @@index([studentId, dateFrom, dateTo])
  @@index([guardianId, status])
  @@index([requestedById, status])
  @@index([status, createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
}

model NotificationLog {
  id              String              @id @default(uuid()) @db.Uuid
  channel         NotificationChannel
  status          NotificationStatus  @default(PENDING)
  recipient       String
  recipientUserId String?             @db.Uuid
  recipientName   String?
  subject         String?
  message         String
  templateKey     String?
  dedupeKey       String?             @unique
  entityType      String?
  entityId        String?
  attempts        Int                 @default(0)
  lastError       String?
  sentAt          DateTime? @db.Timestamptz(3)
  failedAt        DateTime? @db.Timestamptz(3)
  readAt          DateTime? @db.Timestamptz(3)
