  subject   String?
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([channel, isActive])
}

model FeeType {
  id           String       @id @default(uuid()) @db.Uuid
  schoolYearId String?      @db.Uuid
  name         String
  code         String       @unique
  description  String?
  amount       Decimal      @db.Decimal(14, 2)
  frequency    FeeFrequency @default(ONCE)
  isActive     Boolean      @default(true)
  schoolYear   SchoolYear?  @relation(fields: [schoolYearId], references: [id])
  invoices     Invoice[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  @@index([schoolYearId, isActive])
  @@index([frequency])
}

model PaymentMethod {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  code        String            @unique
  type        PaymentMethodType
  provider    String?
  accountName String?
  accountNo   String?
  isActive    Boolean           @default(true)
  payments    Payment[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  @@index([type, isActive])
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  feeTypeId     String        @db.Uuid
  studentId     String        @db.Uuid
  guardianId    String?       @db.Uuid
  schoolYearId  String?       @db.Uuid
  period        String?
  amount        Decimal       @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime? @db.Timestamptz(3)
  dueAt         DateTime? @db.Timestamptz(3)
  paidAt        DateTime? @db.Timestamptz(3)
  voidedAt      DateTime? @db.Timestamptz(3)
  notes         String?
  feeType       FeeType       @relation(fields: [feeTypeId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])
  guardian      Guardian?     @relation(fields: [guardianId], references: [id])
  schoolYear    SchoolYear?   @relation(fields: [schoolYearId], references: [id])
  payments      Payment[]
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)

  @@index([studentId, status])
  @@index([guardianId, status])
  @@index([schoolYearId, status])
  @@index([feeTypeId])
  @@index([dueAt, status])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String        @db.Uuid
  studentId       String        @db.Uuid
  guardianId      String?       @db.Uuid
  paymentMethodId String        @db.Uuid
  receivedById    String?       @db.Uuid
  amount          Decimal       @db.Decimal(14, 2)
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime? @db.Timestamptz(3)
  confirmedAt     DateTime? @db.Timestamptz(3)
  referenceNo     String?
  notes           String?
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
  guardian        Guardian?     @relation(fields: [guardianId], references: [id])
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  receivedBy      User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  @@index([invoiceId, status])
  @@index([studentId, status])
  @@index([guardianId, status])
  @@index([paymentMethodId])
  @@index([receivedById])
  @@index([referenceNo])
}


model OutgoingLetter {
  id             String                @id @default(uuid()) @db.Uuid
  subject        String
  recipient      String
  letterDate     DateTime              @db.Date
  body           String                @db.Text
  status         OutgoingLetterStatus  @default(DRAFT)
  signatureMode  SignatureMode         @default(MANUAL)
  letterNumber   String?               @unique
  createdById    String                @db.Uuid
  approvedById   String?               @db.Uuid
  submittedAt    DateTime?             @db.Timestamptz(3)
  approvedAt     DateTime?             @db.Timestamptz(3)
  revisionNote   String?
  approvalCode   String?               @unique
  contentHash    String?
  letterheadSnapshot Json?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  creator        User                  @relation("OutgoingLetterCreator", fields: [createdById], references: [id])
  approver       User?                 @relation("OutgoingLetterApprover", fields: [approvedById], references: [id])
  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@index([approvedById, approvedAt])
}

model IncomingLetter {
  id              String   @id @default(uuid()) @db.Uuid
  referenceNumber String?
  sender          String
  subject         String
  letterDate      DateTime? @db.Date
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)
  notes           String?  @db.Text
  archiveKey      String?
  archiveName     String?
  archiveMimeType String?
  archiveSize     Int?
  receivedById    String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  receiver        User     @relation("IncomingLetterReceiver", fields: [receivedById], references: [id])
  @@index([receivedAt])
  @@index([referenceNumber])
}
